[Unit]
Description=Robot Kanka AI Service
# multi-user.target sonrası: sistem servisleri ayağa kalktıktan sonra başlar.
# Requires=speaker-enable boot'ta iş kuyruğuna alınmayı engelleyebilir → Wants kullanılır.
# Ağ/ses kontrolü health_check.sh içinde.
After=multi-user.target network.target sound.target bluetooth.target bluealsa.service speaker-enable.service
Wants=network.target speaker-enable.service
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=@USER@
Group=@USER@
WorkingDirectory=@ROOT@
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-@ROOT@/.env
ExecStartPre=@ROOT@/scripts/health_check.sh
ExecStart=@ROOT@/venv/bin/python @ROOT@/main.py
Restart=always
RestartSec=10
StandardOutput=append:/var/log/robot-kanka.log
StandardError=append:/var/log/robot-kanka-error.log

[Install]
WantedBy=multi-user.target
