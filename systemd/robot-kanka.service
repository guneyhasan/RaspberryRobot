[Unit]
Description=Robot Kanka AI Service
After=network-online.target bluetooth.target sound.target bluealsa.service speaker-enable.service
Wants=network-online.target
Requires=speaker-enable.service

[Service]
Type=simple
User=@USER@
Group=@USER@
WorkingDirectory=@ROOT@
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-@ROOT@/.env
ExecStartPre=@ROOT@/scripts/health_check.sh
ExecStart=@ROOT@/venv/bin/python @ROOT@/main.py
Restart=always
RestartSec=10
StartLimitIntervalSec=60
StartLimitBurst=3
StandardOutput=append:/var/log/robot-kanka.log
StandardError=append:/var/log/robot-kanka-error.log

[Install]
WantedBy=multi-user.target
