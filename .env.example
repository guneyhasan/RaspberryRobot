OPENAI_API_KEY=sk-your-key-here
MODEL=gpt-4o-mini
VISION_MODEL=gpt-4o
TTS_VOICE=spruce
MAX_TOKENS=100
TIMEOUT_SECONDS=8
PICOVOICE_ACCESS_KEY=

# Alternatif LLM: Groq Cloud (OpenAI yoksa otomatik kullanılır)
# İkisi de doluysa LLM_PROVIDER ile seç: openai | groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_STREAM=1
GROQ_TEMPERATURE=0.6
GROQ_TOP_P=1
LLM_PROVIDER=

# Wake kelimesi zorunluluğunu geliştirme için kapat: 0/1
REQUIRE_WAKE_PHRASE=1

# Konuşma modu: hey kanka ile aç, görüşürüz kanka ile kapat
CONVERSATION_ACTIVATE_PHRASES=hey kanka
CONVERSATION_DEACTIVATE_PHRASES=görüşürüz kanka,gorusuruz kanka

# ALSA mic: arecord -l ile kart numarasını bulun (USB mic genelde card 1 → plughw:1,0)
# Test: arecord -D plughw:1,0 -f S16_LE -r 16000 -c 1 -d 3 | wc -c  (~96000 olmalı)
AUDIO_INPUT_ALSA_DEVICE=plughw:1,0

# Konuşma bekleme süresi (saniye); arecord hatasında LISTEN_FAST_FAIL_BACKOFF_SEC devreye girer
LISTEN_WAIT_SEC=30
LISTEN_FAST_FAIL_BACKOFF_SEC=0.35

# Ses çıkışı: önce bash scripts/setup_alsa_hifiberry.sh → hb
# .asoundrc yoksa doğrudan HiFiBerry (genelde card 0):
# AUDIO_OUTPUT_ALSA_DEVICE=plughw:0,0
AUDIO_OUTPUT_ALSA_DEVICE=plughw:0,0

# Bluetooth kulaklık modu (bluealsa; kurulum: scripts/setup_bluetooth_audio.sh)
BLUETOOTH_ENABLED=1
BLUETOOTH_SCAN_SEC=12
BLUETOOTH_CONNECT_TIMEOUT_SEC=25
BLUETOOTH_A2DP_PROFILE=a2dp
BLUETOOTH_LIST_PAIRED_ONLY=0
BLUETOOTH_MAX_LIST=8
BLUETOOTH_AUTO_CONNECT_PAIRED=1
BLUETOOTH_PAIR_TIMEOUT_SEC=45
# Boş = AUDIO_OUTPUT_ALSA_DEVICE (robot hoparlörü, örn. plughw:0,0)
BLUETOOTH_SPEAKER_ALSA_DEVICE=

# Piper modelini doğrudan seçmek istersen (opsiyonel)
PIPER_MODEL_PATH=

# Pil izleme (Robot-HAT)
BATTERY_POLL_SEC=20
BATTERY_VOLTAGE_MIN=6.4
BATTERY_VOLTAGE_MAX=8.4
BATTERY_CRITICAL_PERCENT=10

# Motion (Robot-HAT)
MOTION_ENABLED=1
# Robot-HAT v4'te genelde Motors()[1] ve Motors()[2] kullanılır (varsayılanlar 1/2).
DRIVE_MOTOR_LEFT=1
DRIVE_MOTOR_RIGHT=2
# Eğer sizde Motor(pwm, dir) imzası varsa aşağıdakileri doldurun.
# (Port formatı robot_hat sürümüne göre değişebilir: "P12" gibi.)
DRIVE_LEFT_PWM=
DRIVE_LEFT_DIR=
DRIVE_RIGHT_PWM=
DRIVE_RIGHT_DIR=
STEERING_SERVO_PORT=P2
STEERING_CENTER_DEG=0
STEERING_MIN_DEG=-30
STEERING_MAX_DEG=30
DEFAULT_DRIVE_THROTTLE=55
DEFAULT_TURN_DEG=25
DEFAULT_MOVE_SECONDS=1.0

# Head (kafa) pan/tilt servoları (PiCar-X: P0 pan, P1 tilt)
HEAD_ENABLED=1
HEAD_PAN_SERVO_PORT=P0
HEAD_TILT_SERVO_PORT=P1
HEAD_PAN_CENTER_DEG=0
HEAD_TILT_CENTER_DEG=0
HEAD_PAN_MIN_DEG=-90
HEAD_PAN_MAX_DEG=90
HEAD_TILT_MIN_DEG=-45
HEAD_TILT_MAX_DEG=45
HEAD_NUDGE_DEG=20

# Wyoming openWakeWord (ayrı sunucu). Örnek: WYOMING_OPENWAKEWORD_URI=tcp://127.0.0.1:10400
# Boş bırak: sadece transkript wake (kanka / cihan / hey robot).
WYOMING_OPENWAKEWORD_URI=
# Virgülle model adları; boş = sunucu varsayılanı (genelde okay_nabu). Özel .tflite tabanı: my_word
WYOMING_WAKE_NAMES=

PORCUPINE_KEYWORD_PATH=
PORCUPINE_BUILTIN_KEYWORD=computer

# whisper.cpp: ikili kökte `main` veya `build/bin/whisper-cli` olabilir; boş bırakırsanız otomatik aranır.
# WHISPER_BINARY=/home/USER/RaspberryRobot/whisper.cpp/build/bin/whisper-cli
# WHISPER_MODEL=/home/USER/RaspberryRobot/whisper.cpp/models/ggml-base.bin
# Otomatik seçim: base (quant) > tiny > small. Türkçe + hız için base önerilir.
# STT: server = whisper-server (model bellekte kalır, hızlı). cli = her seferinde whisper-cli.
# whisper-server yoksa otomatik cli seçilir. scripts/build_whisper.sh whisper-server derler.
# WHISPER_STT_BACKEND=server
# WHISPER_SERVER_SPAWN=1
# WHISPER_SERVER_HOST=127.0.0.1
# WHISPER_SERVER_PORT=8777
# WHISPER_SERVER_START_TIMEOUT_SEC=180
# WHISPER_SERVER_BASE_URL=http://127.0.0.1:8777
# Düşük gecikme decode (beam/best-of düşük, no-fallback). Sorun çıkarsa 0 yapın.
# WHISPER_FAST_DECODE=1
# Son tur metnini Whisper prompt olarak gönderir (öğrenme değil). WHISPER_STT_DIALOG_HINT=1
# Decoder bağlamı taşıma (biraz daha ağır): WHISPER_STT_CARRY_CONTEXT=0
AUDIO_INPUT_ALSA_DEVICE=plughw:1,0
WAKE_PHRASES=kanka,hey kanka
SILENCE_END_SEC=0.7
VAD_THRESHOLD=0.45
VAD_MIN_SPEECH_SEC=0.25
VAD_ADAPTIVE_ENDPOINTING=1
VAD_ADAPTIVE_MIN_SPEECH_SEC=0.5
VAD_ADAPTIVE_SILENCE_SEC=0.35

# Konuşma modu sessizlik yoklaması
CONVERSATION_NUDGE_ENABLED=1
CONVERSATION_NUDGE_SEC=8
CONVERSATION_NUDGE_COOLDOWN_SEC=25

# LLM/TTS streaming (daha hızlı ilk ses)
OPENAI_STREAM=1
LLM_STREAM_ENABLED=1
LLM_STREAM_MIN_SENTENCE_CHARS=12
TTS_SENTENCE_PAUSE_SEC=0.1
TTS_PREFER_PIPER_FOR_NUDGE=1

# Deneysel kısmi STT (varsayılan kapalı)
WHISPER_PARTIAL_HINT=0
WHISPER_PARTIAL_INTERVAL_SEC=1.2
WHISPER_THREADS=4
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_STREAM=1
GROQ_TEMPERATURE=0.6
GROQ_TOP_P=1
# Pil izleme (Robot-HAT)
BATTERY_POLL_SEC=20
BATTERY_VOLTAGE_MIN=6.4
BATTERY_VOLTAGE_MAX=8.4
BATTERY_CRITICAL_PERCENT=10


